# === TirePlus Staging .htaccess ===
# Goal: always serve fresh content; no SiteGround Dynamic Cache, no browser cache

# Permanent redirects for retired URLs (tire-search + wheel-search merged into search)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^tire-search/?$ /search/ [R=301,L]
  RewriteRule ^wheel-search/?$ /search/ [R=301,L]
  RewriteRule ^fr/recherche-pneus/?$ /fr/recherche/ [R=301,L]
  RewriteRule ^fr/recherche-roues/?$ /fr/recherche/ [R=301,L]
  RewriteRule ^appointments/?$ /book-appointment/ [R=301,L]
  RewriteRule ^fr/rendez-vous/?$ /fr/prendre-rendez-vous/ [R=301,L]
  # /request-service/ ran TireConnect's AutoService module. Retired: its requests
  # landed in TireConnect rather than Tekmetric, so the shop had two inboxes for
  # one job. Redirected rather than left to 404 — these URLs are in Google, in
  # business listings, and on printed material, and a 404 loses the customer
  # where a redirect keeps them.
  RewriteRule ^request-service/?$ /book-appointment/ [R=301,L]
  RewriteRule ^fr/demande-de-service/?$ /fr/prendre-rendez-vous/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # Tell SiteGround Dynamic Cache + browsers: never cache
  Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, private"
  Header set Pragma "no-cache"
  Header set Expires "0"
  # Keep staging out of Google
  Header set X-Robots-Tag "noindex, nofollow"

  # Security headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Content-Security-Policy — same two headers as production, kept in sync so
  # staging is where the report-only allowlist gets validated before being
  # promoted to enforced. See .htaccess.production for the full rationale and
  # the promotion procedure.
  Header set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  Header set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://elfsightcdn.com https://app.tireconnect.ca https://booking.tekmetric.com https://www.googletagmanager.com https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com https://booking.tekmetric.com https://elfsightcdn.com; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; connect-src 'self' https://api-new.getmxpert.com https://app.tireconnect.ca https://booking.tekmetric.com https://cdn.jsdelivr.net https://elfsightcdn.com https://*.elfsight.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src 'self' https://www.google.com https://booking.tekmetric.com https://app.tireconnect.ca https://*.elfsight.com https://td.doubleclick.net; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>

# Block access to hidden files
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Default charset
AddDefaultCharset UTF-8

# Error pages
ErrorDocument 404 /index.html
