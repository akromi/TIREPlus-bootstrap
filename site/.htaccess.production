# === TirePlus Production .htaccess ===

# Permanent redirects for retired URLs (tire-search + wheel-search merged into search)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^tire-search/?$ /search/ [R=301,L]
  RewriteRule ^wheel-search/?$ /search/ [R=301,L]
  RewriteRule ^fr/recherche-pneus/?$ /fr/recherche/ [R=301,L]
  RewriteRule ^fr/recherche-roues/?$ /fr/recherche/ [R=301,L]
  RewriteRule ^appointments/?$ /book-appointment/ [R=301,L]
  RewriteRule ^fr/rendez-vous/?$ /fr/prendre-rendez-vous/ [R=301,L]
  # /request-service/ ran TireConnect's AutoService module. Retired: its requests
  # landed in TireConnect rather than Tekmetric, so the shop had two inboxes for
  # one job. Redirected rather than left to 404 — these URLs are in Google, in
  # business listings, and on printed material, and a 404 loses the customer
  # where a redirect keeps them.
  RewriteRule ^request-service/?$ /book-appointment/ [R=301,L]
  RewriteRule ^fr/demande-de-service/?$ /fr/prendre-rendez-vous/ [R=301,L]
</IfModule>

# Enable browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  # A year, not a month, because every reference to these carries a ?v= content
  # hash from build.js — the URL changes the moment the bytes do, so a long life
  # costs nothing and buys a returning visitor the whole site from cache.
  #
  # This is only safe while EVERY reference is versioned. An unversioned
  # /css/style.css would be pinned for a year at a URL that never changes, which
  # is the same bug this replaced, a year long instead of a month. The
  # "local assets are cache-busted" job in .github/workflows/ci.yml fails the
  # build if an unversioned reference ever lands, so the rule is enforced rather
  # than remembered.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  # Nearly every image on this site is .webp (see site/img/). Without this line
  # the site's dominant image format was the one format getting no cache header.
  ExpiresByType image/webp "access plus 1 year"
</IfModule>

# Security headers.
#
# Wrapped in mod_headers, matching .htaccess.staging. Unwrapped `Header` on a
# host without mod_headers is a 500 on every page, not a skipped header.
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # --- Content-Security-Policy, in two parts ---
  #
  # ENFORCED: only directives that cannot break a page that renders today.
  # None of them govern loading a subresource, so no widget can be starved by
  # them. frame-ancestors 'self' is the modern spelling of the X-Frame-Options
  # line above (kept for pre-CSP browsers); the rest close off injection
  # vectors nothing here uses.
  Header set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"

  # REPORT-ONLY: the resource allowlist. Violations are logged to the browser
  # console and nothing is blocked.
  #
  # This is deliberately not enforced yet. Four third parties inject their own
  # subresources at runtime — TireConnect, Tekmetric, Elfsight, and Mxpert —
  # and their origins can only be confirmed by watching real traffic, not by
  # reading this repo. Enforcing an incomplete allowlist would silently kill
  # the tire quote widget, which is the site's main conversion path.
  #
  # Note both 'unsafe-inline's are load-bearing: the GA4 snippet, the JSON-LD
  # block, the TireConnect/Tekmetric init blocks and the <style> block in
  # head.html are all inline, as are the styles these widgets inject. So this
  # policy buys origin restriction, NOT XSS immunity — an injected inline
  # <script> would still run. Removing 'unsafe-inline' means moving every
  # inline block to a file or hashing each one per build; worth doing, but a
  # bigger change than this.
  #
  # To promote to enforced (see README "Content-Security-Policy"):
  #   1. Browse staging with DevTools open — every page, both languages, and
  #      exercise tire search, booking, chat and the contact form.
  #   2. Add any origin the console reports to the matching directive here.
  #   3. Once a full pass is clean, merge these directives into the enforced
  #      header above and delete this one.
  # Served as an error document, /404.html carries Apache's 404 status and is
  # not indexable. Requested DIRECTLY it is an ordinary file and returns 200 —
  # indexable, and worth nothing in results. It is not in sitemap.xml, so this
  # only matters if something links to it, but the cost of being wrong is a
  # "Page not found" entry in Google under the shop's own domain.
  <Files "404.html">
    Header set X-Robots-Tag "noindex"
  </Files>

  Header set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://elfsightcdn.com https://app.tireconnect.ca https://booking.tekmetric.com https://www.googletagmanager.com https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com https://booking.tekmetric.com https://elfsightcdn.com; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; connect-src 'self' https://api-new.getmxpert.com https://app.tireconnect.ca https://booking.tekmetric.com https://cdn.jsdelivr.net https://elfsightcdn.com https://*.elfsight.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src 'self' https://www.google.com https://booking.tekmetric.com https://app.tireconnect.ca https://*.elfsight.com https://td.doubleclick.net; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>

# Block access to hidden files
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Block test harness
<Files "test-harness.html">
  Require all denied
</Files>

# Default charset
AddDefaultCharset UTF-8

# Error pages
#
# Was /index.html, which served the HOMEPAGE BODY under a 404 status: a visitor
# who mistyped a URL got the front page with nothing telling them the address
# was wrong, and a French visitor got it in English. /404.html says what
# happened, in both languages, and offers the routes back in.
ErrorDocument 404 /404.html
